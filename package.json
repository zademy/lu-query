{
  "name": "lu-query",
  "version": "2.19.0",
  "description": "MCP server for Oracle DB over stdio (1:1 port of mcp-oracle-db 2.13.0)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zademy/lu-query"
  },
  "author": "Sadot Hernández Moreno",
  "type": "module",
  "bin": {
    "lu-query": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vp pack",
    "start": "node dist/index.js",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "prepublishOnly": "npm run build",
    "banner": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --hide-scrollbars --force-device-scale-factor=2 --window-size=1600,600 --screenshot=docs/banner.png scripts/banner.html"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@sentry/node": "^10.0.0",
    "node-sql-parser": "^5.3.8",
    "oracledb": "^26.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.5",
    "vite-plus": "1.4.0"
  },
  "allowScripts": {
    "oracledb@26.0.0": true
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  }
}
